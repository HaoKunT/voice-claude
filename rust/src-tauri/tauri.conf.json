{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-claude",
  "version": "0.2.0",
  "identifier": "com.haokunt.voice-claude",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "voice-claude 设置",
        "width": 720,
        "height": 760,
        "minWidth": 640,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBQjgzNjNEQUQ1ODJFNjEKUldSaExsaXRQVGE0cWlFbndodlhubk5MNW0vdDJCb1Z1NHFhbFR1Tmt3bklPUUs2Wm5vMFdsTncK",
      "endpoints": [
        "https://github.com/HaoKunT/voice-claude/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026",
    "shortDescription": "按住热键语音输入",
    "longDescription": "跨平台语音输入法：按热键录音，ASR 识别后自动输入到当前焦点窗口。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "files": {
        "Frameworks/libsherpa-onnx-c-api.dylib": "target/release/libsherpa-onnx-c-api.dylib",
        "Frameworks/libonnxruntime.1.24.4.dylib": "target/release/libonnxruntime.1.24.4.dylib"
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
